# week8/friday/Dockerfile.production
# Two-stage production image for kk-payments.
#
# Build from the repository root (run-week8.sh does this for you):
#   docker build --no-cache -f week8/friday/Dockerfile.production \
#     --build-arg APP_VERSION=<semver>-<git-sha> -t <image>:<tag> payments
# The build context is payments/. Its .dockerignore is a copy of week8/friday/.dockerignore.

# ─── Stage 1: builder ────────────────────────────────────────────────────────
# Same pinned Node image as the Week 5 Jenkins Docker agent, so CI and the
# image build use one toolchain version.
FROM node:22.23.3-alpine AS builder
WORKDIR /app

# Manifests first so the dependency layer is cached until they change
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Source after dependencies, then build dist/
COPY . .
RUN npm run build

# Drop devDependencies (eslint, jest, ...) so only runtime packages remain
RUN npm prune --omit=dev --no-audit --no-fund

# ─── Stage 2: production ─────────────────────────────────────────────────────
# Plain Alpine plus the distro Node.js runtime. node:*-alpine ships npm, yarn
# and corepack, which push it past 100MB; the runtime alone keeps us under it.
FROM alpine:3.22 AS production

# Step 1: runtime and non-root user (as root)
RUN apk add --no-cache 'nodejs~22' \
 && addgroup -S kijani \
 && adduser -S kijani -G kijani

WORKDIR /app

# Step 2: copy only what runs: production node_modules, compiled output, manifest
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./package.json

# Step 3: ownership before dropping root
RUN chown -R kijani:kijani /app

# Build-time version becomes the version reported on /health
ARG APP_VERSION=dev
ENV NODE_ENV=production \
    PORT=3001 \
    APP_VERSION=${APP_VERSION}

# Step 4: drop root for everything that follows, including CMD
USER kijani

EXPOSE 3001

# BusyBox wget is in Alpine; curl is not. 30s start-period covers startup.
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3001/health || exit 1

# Exec form: node is PID 1 and receives SIGTERM directly
CMD ["node", "dist/server.js"]

# week8/friday/Dockerfile.single-stage
# Baseline only: the "Monday" single-stage image, built so the size reduction
# in nia-comparison.md is measured, not estimated. Not used for deployment.
FROM node:22.23.3-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build
EXPOSE 3001
ENV PORT=3001
CMD ["node", "dist/server.js"]
